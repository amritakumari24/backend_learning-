      "item": [
        {
          "name": "Upload Assignment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "courseId",
                  "value": "COURSE_ID",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/assignments/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assignments", "upload"]
            },
            "description": "Upload assignment file to a course (PDF, PNG, JPEG, max 5MB). File is uploaded to Cloudinary"
          },
          "response": []
