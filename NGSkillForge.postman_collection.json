{
  "info": {
    "_postman_id": "ngskillforge-api-collection",
    "name": "NGSkillForge API",
    "description": "Complete REST API collection for NGSkillForge online learning platform with OTP verification, JWT authentication, course management, enrollments, and assignments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Server Health",
          "request": {
            "method": "GET",
            "header": [],
