          "name": "Get My Assignments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assignments/my?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assignments", "my"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": true
                }
              ]
            },
            "description": "Get list of all assignments uploaded by user"
          },
          "response": []
        }
      ]
    },
