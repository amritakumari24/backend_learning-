    {
      "name": "Courses",
      "item": [
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"React Fundamentals\",\n  \"description\": \"Learn React basics including components, hooks, and state management\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "courses"]
            },
            "description": "Create a new course (admin only)"
          },
          "response": []
        },
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses?page=1&limit=10&search=React&sort=latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "courses"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "search",
                  "value": "React",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "latest",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of courses with optional search and sorting"
          },
          "response": []
        },
        {
          "name": "Get Course",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/COURSE_ID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "courses", "COURSE_ID"]
            },
            "description": "Get a single course by ID with instructor details"
          },
          "response": []
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"React Advanced Fundamentals\",\n  \"description\": \"Advanced React topics including custom hooks and performance optimization\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/COURSE_ID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "courses", "COURSE_ID"]
            },
            "description": "Update course details (admin only)"
          },
          "response": []
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/COURSE_ID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "courses", "COURSE_ID"]
            },
            "description": "Delete a course (admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
